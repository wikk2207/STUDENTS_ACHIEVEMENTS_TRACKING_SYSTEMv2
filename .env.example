FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://saams:saams@localhost:5433/eduvo_saams

# Real email for OTP (registration + login)
# Gmail: enable 2-Step Verification, then create an App Password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=SAAMS <your-email@gmail.com>

# Session
PERMANENT_SESSION_LIFETIME=3600
SESSION_TIMEOUT_MINUTES=60

# Uploads
MAX_CONTENT_LENGTH=10485760
UPLOAD_FOLDER=static/uploads

# OCR (optional path to tesseract binary on Windows)
TESSERACT_CMD=

# Mentor security (comma-separated whitelist)
MENTOR_EMAIL=binaryai0010@gmail.com
MENTOR_WHITELIST_EMAILS=binaryai0010@gmail.com
